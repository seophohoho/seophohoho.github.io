source "https://rubygems.org"

gem "jekyll"
gem "minima"
gem "webrick"
gem "logger"

# 플러그인 목록에 jekyll-paginate 추가 (이 줄이 핵심입니다!)
group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-paginate"  # <-- 이 줄을 추가하세요!
end

# Windows/Mac 호환성 및 서버 에러 방지용 (필수)
gem "webrick"

# Ruby 최신 버전 호환성 패치 (방금 에러 해결용)
gem "logger"